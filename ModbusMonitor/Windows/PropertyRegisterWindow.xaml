<Window x:Class="ModbusMonitor.Windows.PropertyRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusMonitor.Windows" 
        xmlns:viewmodel="clr-namespace:ModbusMonitor.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:RegisterPropertiesViewModel}"
        mc:Ignorable="d"
        Height="auto" Width="300" MaxWidth="400" ResizeMode="CanMinimize" Title="Свойства регистра"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen" SizeToContent="Height">
    <Window.Resources>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Background="Gray">
        <Border Background="Lavender" Margin="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Имя устройства">
                    <TextBox Text="{Binding CellData.NameDevice}"/>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Адрес устройства">
                    <TextBox Text="{Binding CellData.DeviceAdress}"/>
                </GroupBox>
                <GroupBox Grid.Row="2" Header="Адрес регистра">
                    <TextBox Text="{Binding CellData.Adress}" IsReadOnly="True"/>
                </GroupBox>
                <GroupBox Grid.Row="3" Header="Тип регистра">
                    <TextBox Text="{Binding CellData.Type}" IsReadOnly="true" />
                </GroupBox>
                <GroupBox Grid.Row="4" Header="Формат">
                    <TextBox Text="{Binding CellData.Format}" IsReadOnly="true" />
                </GroupBox>               
                <GroupBox Grid.Row="5" Header="Имя регистра">
                    <TextBox Text="{Binding CellData.Name, UpdateSourceTrigger=PropertyChanged}"/>
                </GroupBox>
                <GroupBox Grid.Row="6" Header="Значение">
                    <TextBox Text="{Binding CellData.Value}" IsReadOnly="True"/>
                </GroupBox>                
                    <Button Grid.Row="7" IsCancel="True" Content="Закрыть" Margin="50,10"/>             
            </Grid>
        </Border>
    </Grid>
</Window>
