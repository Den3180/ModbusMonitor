<Window x:Class="ModbusMonitor.Windows.SearchAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusMonitor.Windows"
        mc:Ignorable="d"
        Title="Поиск адреса устройства" Height="auto" Width="auto" WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Background="#FFF9F5F5" Margin="5">
            <GroupBox Header="COM порт">
                <ComboBox IsReadOnly="True" IsEditable="False" VerticalAlignment="Center" Margin="5" />
            </GroupBox>
            <Button Content="Поиск" Margin="15" FontSize="16" HorizontalAlignment="Center" FontWeight="Bold" Padding="7"/>
            <GroupBox  Header="Параметры подключения">
                <UniformGrid Rows="5" Columns="2">
                    <TextBlock Text="Speed: "/>
                    <TextBlock Text="no" />
                    <TextBlock Text="DataBits: "/>
                    <TextBlock Text="no" />
                    <TextBlock Text="Parity: "/>
                    <TextBlock Text="no" />
                    <TextBlock Text="StopBits: "/>
                    <TextBlock Text="no" />
                    <TextBlock Text="Address: "/>
                    <TextBlock Text="no" />
                </UniformGrid>
            </GroupBox>
            <GroupBox Header="Время" VerticalAlignment="Bottom">
                <TextBlock Text="00:00:00" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18"/>
            </GroupBox>
        </StackPanel>
        <StackPanel  Grid.Row="0" Grid.Column="1" Background="#FFF9F5F5" Margin="5">
            <GroupBox Header="Скорость (бод)">
                <StackPanel Margin="2" Background="#FFF9F5F5">
                    <RadioButton Content="300"/>
                    <RadioButton Content="600"/>
                    <RadioButton Content="1200"/>
                    <RadioButton Content="2400"/>
                    <RadioButton Content="4800"/>
                    <RadioButton Content="7200"/>
                    <RadioButton Content="9600" IsChecked="True"/>
                    <RadioButton Content="14400"/>
                    <RadioButton Content="19200"/>
                    <RadioButton Content="38400"/>
                    <RadioButton Content="56000"/>
                    <RadioButton Content="57600"/>
                    <RadioButton Content="115200"/>
                    <RadioButton Content="128000"/>
                    <RadioButton Content="14400"/>
                    <RadioButton Content="256000"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Background="#FFF9F5F5" Margin="5">
            <GroupBox Header="DataBits">
                <StackPanel>
                    <RadioButton Content="7"/>
                    <RadioButton Content="8" IsChecked="True"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Parity">
                <StackPanel>
                    <RadioButton Content="None" IsChecked="True"/>
                    <RadioButton Content="Odd"/>
                    <RadioButton Content="Even"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="StopBits">
                <StackPanel>
                    <RadioButton Content="1" IsChecked="True"/>
                    <RadioButton Content="2"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Диапазон адресов">
                <UniformGrid VerticalAlignment="Top">
                    <TextBlock Text="Начало"/>
                    <TextBox Text="0" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Конец"/>
                    <TextBox Text="0" VerticalContentAlignment="Center"/>
                </UniformGrid>
            </GroupBox>
        </StackPanel>
        <StackPanel  Grid.Row="0" Grid.Column="3" Background="#FFF9F5F5" Margin="5">
            <GroupBox Header="Результаты сканирования">
                <StackPanel>
                    <ListBox Background="White" MinHeight="316" MinWidth="200"/>
                    <Button Content="Очистить" Margin="5"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="0" Margin="2" Grid.ColumnSpan="3" 
               Background="#FFF9F5F5" VerticalAlignment="Center">
            <ProgressBar Margin="15,10" VerticalAlignment="Center" MinHeight="20"
                         Background="LightCyan" Foreground="#FF222DDC"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="3" Background="#FFF9F5F5">
            <Button Content="Выход" Margin="20,5" FontSize="18" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
