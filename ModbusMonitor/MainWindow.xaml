<Window x:Class="ModbusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModbusMonitor"
        xmlns:src="clr-namespace:ModbusMonitor.Classes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        d:DataContext="{d:DesignInstance Type=local:ViewModelMain}"
        mc:Ignorable="d"
        Title="ModbusMonitor" Height="450" Width="1000" WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
        </Style>        
            <Style TargetType="{x:Type GroupBox}">                
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="1"/>               
                <Setter Property="FontSize" Value="14"/>
            </Style>        
    </Window.Resources>
    <Grid Background="Gray">        
    <DockPanel LastChildFill="True" Background="Lavender" Margin="2">
        <!--Меню-->
        <Menu DockPanel.Dock="Top" VerticalAlignment="Top" Background="{x:Null}">
            <MenuItem Header="Файл" VerticalAlignment="Center">
                <MenuItem Header="Загрузить карту регистров" Command="{Binding LoadMapCommand}"/>
                <Separator/>
                <MenuItem Header="Сохранить карту регистров" Command="{Binding SaveMapcomman}"/>
                <Separator/>
                <MenuItem Header="Поиск адреса" Command="{Binding SearchAddressCommand}"/>
                <Separator/>
                <MenuItem Header="Открыть лог" Command="{Binding OpenLogCommand}"/>
                <Separator/>
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Вид" VerticalAlignment="Center">
                <MenuItem Header="Таблица" Command="{Binding TableCommand}"/>
                <MenuItem Header="Текст" Command="{Binding TextCommand}"/>
                <MenuItem Header="Просмотр пакетов" Command="{Binding ViewingPackagesCommand}"/>               
                <MenuItem Header="Коэффициенты" IsCheckable="True" Command="{Binding RatioCommand}"/>
                <MenuItem Header="Формат" IsCheckable="True" Command="{Binding FormatCommand}"/>
                <MenuItem Header="Цвета для типов" IsCheckable="True" Command="{Binding ColorTypeCommand}"/>
                <Separator/>
                <MenuItem Header="Сброс ширины столбцов" Command="{Binding ResetColCommand}"/>
            </MenuItem>
            <MenuItem Header="Инструменты" VerticalAlignment="Center">
                        <MenuItem Header="Записать регистр" Command="{Binding WriteRegisterCommand}"/>
            <MenuItem Header="Устройство" VerticalAlignment="center">                    
                        <MenuItem Header="Запрос данных" Command="{Binding SendRequestCommand}"/>
                        <MenuItem Header="Включить опрос" Command="{Binding ListenPortCommand}"/>
                        <MenuItem Header="Отключить опрос" Command="{Binding DisablePollCommand}"/>
            </MenuItem>
                <Separator/>
                <MenuItem Header="Открыть лог ошибок" Command="{Binding OpenLogErrCommand}"/>
                <MenuItem Header="Очистить лог ошибок" Command="{Binding ClearLogErrCommand}"/>
            </MenuItem>
            <MenuItem Header="Сервис" VerticalAlignment="Center">
                <MenuItem Header="Параметры" Command="{Binding ParamCommand}"/>
            </MenuItem>
            <MenuItem Header="Справка" VerticalAlignment="Center" Command="{Binding HelpCommand}">
                <MenuItem Header="Справка" InputGestureText="F1" Command="{Binding AboutCommand}"/>
                <Separator/>
                <MenuItem Header="О программе"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" VerticalAlignment="Center" BorderBrush="#FFF5F5FD" 
                BorderThickness="0.7">            
        <ToolBarTray  Background="{x:Null}" IsLocked="False" VerticalAlignment="Center">
            <ToolBarTray.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="auto"/>
                        <Setter Property="Height" Value="auto"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="Image">                       
                        <Setter Property="Stretch" Value="UniformToFill"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Width" Value="25"/>
                        <Setter Property="Height" Value="25"/>
                        <Setter Property="Margin" Value="1"/>
                    </Style>
                </ToolBarTray.Resources>
            <ToolBar Band="1" BandIndex="1" Background="{x:Null}">              
                <Button Command="{Binding LoadMapCommand}" ToolTip="Загрузить карту регистров" >
                    <Image Source="/Resources/LoadMap.PNG"/>
                </Button>
                <Button Command="{Binding SaveMapcomman}" ToolTip="Сохранить карту регистров">
                    <Image Source="/Resources/SaveIcon1.PNG"/>                   
                </Button>
                <Button Command="{Binding SearchAddressCommand}" ToolTip="Поиск адреса устройства">
                    <Image Source="/Resources/searchAddress.png" />
                </Button>
                <Button Command="{Binding ExitCommand}" ToolTip="Выход">
                    <Image Source="/Resources/ExitApp.png" />
                </Button>
            </ToolBar>
            <ToolBar Band="1" BandIndex="2" Background="{x:Null}">
                    <Button Command="{Binding TableCommand}" ToolTip="Таблица">
                        <Image Source="/Resources/Tablitsa.png" />
                    </Button>
                    <Button Command="{Binding TextCommand}" ToolTip="Текст">
                        <Image Source="/Resources/Tekst.png" />
                    </Button>
                    <Button Command="{Binding ViewingPackagesCommand}" ToolTip="Просмотр пакетов">
                        <Image Source="/Resources/Prosmotr.png" />
                    </Button>
                    <Button Command="{Binding RatioCommand}" ToolTip="Коэффициенты">
                        <Image Source="/Resources/koef.png" />
                    </Button>
                    <Button Command="{Binding FormatCommand}" ToolTip="Формат регистра">
                        <Image Source="/Resources/format.png" />
                    </Button>
                    <Button Command="{Binding ColorTypeCommand}" ToolTip="Цвета для типов">
                        <Image Source="/Resources/colortype.png" />
                    </Button>
                    <Button Command="{Binding ResetColCommand}" ToolTip="Сброс ширины столбцов">
                        <Image Source="/Resources/Stolbwight.png" />
                    </Button>
                </ToolBar>
                <ToolBar Band="1" BandIndex="3" Background="{x:Null}">
                    <Button Command="{Binding WriteRegisterCommand}" ToolTip="Запись в регистр">
                        <Image Source="/Resources/WriteReg.png" />
                    </Button>
                    <Button Command="{Binding SendRequestCommand}" ToolTip="Запрос данных">
                        <Image Source="/Resources/zaprosData.png" />
                    </Button>
                    <Button Command="{Binding ListenPortCommand}" ToolTip="Включить опрос">
                        <Image Source="/Resources/turnon.png" />
                    </Button>
                    <Button Command="{Binding DisablePollCommand}" ToolTip="Отключить опрос">
                        <Image Source="/Resources/DisPoll.png" />
                    </Button>                    
                </ToolBar>
                <ToolBar Band="1" BandIndex="4" Background="{x:Null}">
                    <Button Command="{Binding ParamCommand}" ToolTip="Параметры">
                        <Image Source="/Resources/param.png" />
                    </Button>
                </ToolBar>
                <ToolBar Band="1" BandIndex="5" Background="{x:Null}">
                    <Button Command="{Binding HelpCommand}" ToolTip="Справка">
                        <Image Source="/Resources/Help.png" />
                    </Button>
                    <Button Command="{Binding AboutCommand}" ToolTip="О программе">
                        <Image Source="/Resources/about.png" />
                    </Button>
                </ToolBar>
            </ToolBarTray>         
        </Border>
        <!--Статус бар-->
        <StatusBar DockPanel.Dock="Bottom" Height="25" VerticalAlignment="Bottom" 
                   Background="{x:Null}" BorderBrush="#FFF5F5FD" BorderThickness="1">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Content="Время запроса=" />
            <StatusBarItem Grid.Column="1" Content="0"/>
            <Separator Grid.Column="2"/>
            <Separator Grid.Column="4"/>
            <StatusBarItem Grid.Column="5" Content="Запросы:"/>
            <StatusBarItem Grid.Column="6" Content="{Binding NumberRequest}"/>
            <Separator Grid.Column="7"/>
            <StatusBarItem Grid.Column="8" Content="Корректные ответы:"/>
            <StatusBarItem Grid.Column="9" Content="{Binding CorrectRequest}"/>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" MinWidth="300" MaxWidth="500"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" HorizontalAlignment="Stretch" Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>
                <!--Подключения-->
                <GroupBox Header="Подключения" Grid.Row="0" Margin="2" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="3">
                            <Button Command="{Binding CreateConnectCommand}" Content="Создать" Margin="2"/>
                            <Button Command="{Binding ConnectionCommand}" Content="Подключение" Margin="2"/>
                            <Button Command="{Binding DisconnectionCommand}" Content="Отключение" Margin="2"/>
                        </UniformGrid>                                                           
                               <TreeView Grid.Row="1" Margin="2" ItemsSource="{Binding TreeNodes}" 
                                  MinWidth="300" IsEnabled="{Binding TreeViewEnabled}"
                                  MaxWidth="300"                                   
                                  BorderBrush="White" Tag="{Binding ColorTextTreeConnect}" >
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Добавить" Command="{Binding CreateConnectCommand}"/>
                                        <MenuItem Header="Изменить"/>
                                        <MenuItem Header="Обновить"/>
                                        <Separator/>
                                        <MenuItem Header="Подключить" Command="{Binding ConnectionCommand}"/>
                                        <MenuItem Header="Отключить" Command="{Binding DisconnectionCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить" Command="{Binding ClearTreeSingleCommand}"/>
                                        <MenuItem Header="Удалить все" Command="{Binding ClearTreeAllCommand}"/>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.Resources>                                
                                    <HierarchicalDataTemplate DataType="{x:Type src:GroupsTreeNode}"
                                                              ItemsSource="{Binding SubGroups}">                                        
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock>
                                                <Run Text="Устройство"/>
                                                <Run FontWeight="Bold" Text="{Binding NameCOM}"/>
                                                <Run Text="---"/>
                                                <Run FontWeight="Bold" Text="{Binding State}"                                                      
                                                 Foreground="{Binding ColorTextTreeConnect}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type src:SubGroupsTree}">                                        
                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Run Text="{Binding SubHeaderPort}"/>                                                
                                                <Run Text="{Binding ContentPort}" FontWeight="Bold"/>
                                                <LineBreak/>
                                                <Run Text="{Binding SubHeaderAddress}"/>                                                
                                                <Run Text="{Binding ContentAddress}" FontWeight="Bold"/>
                                                <LineBreak/>
                                                <Run Text="{Binding SubHeaderName}"/>
                                                <Run Text="{Binding ContentName}" FontWeight="Bold"/>                                                
                                            </TextBlock>                                        
                                    </DataTemplate>
                                    <Style TargetType="{x:Type TreeViewItem}">
                                        <Setter Property="IsExpanded" Value="True" />                                       
                                    </Style>                                    
                                </TreeView.Resources>                                  
                                <i:Interaction.Behaviors>
                                    <src:BindableSelectedItemBehavior SelectedItem="{Binding SelectedItemTree, Mode=TwoWay}" />
                                </i:Interaction.Behaviors>                               
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                    <i:InvokeCommandAction Command="{Binding CreateConnectCommand}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>                              
                        </TreeView>                                                 
                    </Grid>
                </GroupBox>
                <!--Добавление регистров-->
                <GroupBox Grid.Row="1" Header="Добавление регистров" Margin="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Подключение" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="2"
                                  Text="Выберите тип" IsEditable="True" IsReadOnly="True" MaxHeight="22"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Адрес и имя устройства:" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceAddress}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DeviceName}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Тип и формат регистра:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DataFormat}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="Добавить данные" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                        <Button Grid.Row="3" Grid.Column="2" Margin="2" Content="Добавить"/>
                    </Grid>
                </GroupBox>
            </Grid>
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch"/>
            <!--Окно данных, лист логов и кнопки-->
            <Border Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto" MinHeight="80"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2">
                        <Button Content="Добавить ячейки" HorizontalAlignment="Left" Margin="2"/>
                        <DockPanel Width="auto">
                            <Button DockPanel.Dock="Right" Content="@" HorizontalAlignment="Right" Margin="2"/>
                            <Button DockPanel.Dock="Right" Content="Очистить" HorizontalAlignment="Right" Margin="2"/>
                        </DockPanel>
                    </UniformGrid>
                    <Border Grid.Row="1" Background="#FFDDD6D6">
                        <!--Окно данных-->
                        <ContentControl Content="{Binding Usercontrol}"/>
                    </Border>
                    <GridSplitter Grid.Row="2" Height="2" 
                                  HorizontalAlignment="Stretch"/>
                    <ListBox Grid.Row="3" VerticalAlignment="Stretch" 
                             HorizontalAlignment="Stretch"
                             MinHeight="80"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
    </Grid>
</Window>
