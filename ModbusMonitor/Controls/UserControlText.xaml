<UserControl x:Class="ModbusMonitor.Controls.UserControlText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModbusMonitor.Controls" 
             xmlns:viewmodel="clr-namespace:ModbusMonitor.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:ViewingPackagesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListBox ItemsSource="{Binding SourceData}"/>
    </Grid>
</UserControl>
