<UserControl Name="Cell"
             x:Class="ModbusMonitor.Controls.UserControlDevices"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ModbusMonitor.Classes" 
             xmlns:vmm="clr-namespace:ModbusMonitor"
             xmlns:viewmodel="clr-namespace:ModbusMonitor.ViewModel"             
             d:DataContext="{d:DesignInstance Type=viewmodel:ControlDeviceView}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000" Width="Auto">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Width" Value="auto"/>
        </Style>        
    </UserControl.Resources>
    <Grid>        
        <DataGrid AutoGenerateColumns="False" SelectionMode="Single"
                  ItemsSource="{Binding Cells}"
                  SelectionUnit="FullRow" 
                  HorizontalGridLinesBrush="#FFBDB3B3" 
                  FontSize="16"                  
                  SelectedItem="{Binding SelectedCell}" CanUserSortColumns="False"
                  CurrentColumn="{Binding GridColumn, Mode=TwoWay}" Width="auto" >            
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding WriteRegisterCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <!--Контексное меню-->
            <DataGrid.ContextMenu>
                <ContextMenu>                   
                    <MenuItem Header="График"/>
                    <MenuItem Header="Лог"/>
                    <Separator/>
                    <MenuItem Header="Записать регистр" Command="{Binding WriteRegisterCommand}"/>
                    <MenuItem Header="Добавить ячейки" Command="{Binding AddCellsCommand}"/>
                    <MenuItem Header="Формат">
                        <MenuItem.Resources>
                            <Style x:Key="Format" TargetType="{x:Type MenuItem}">
                                <Setter Property="IsCheckable" Value="True"/>
                                <Setter Property="Command" Value="{Binding EditFormatCommand}"/>                                
                            </Style>
                        </MenuItem.Resources>
                        <MenuItem Header="Bin" Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[0].CheckButton}"/>
                        <MenuItem Header="Hex" Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[1].CheckButton}"/>
                        <MenuItem Header="Int" Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[2].CheckButton}"/>
                        <MenuItem Header="Decimal"  Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[3].CheckButton}"/>
                        <MenuItem Header="Double"   Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[4].CheckButton}"/>
                        <MenuItem Header="swDouble" Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[5].CheckButton}"/>
                        <MenuItem Header="Float"    Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[6].CheckButton}"/>
                        <MenuItem Header="swFloat"  Style="{StaticResource Format}"
                                  IsChecked="{Binding MenuItemCheck[7].CheckButton}"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Вырезать"/>
                    <MenuItem Header="Копировать"/>
                    <MenuItem Header="Вставить"/>
                    <MenuItem Header="Удалить" Command="{Binding DeleteLineCommand}"/>
                    <MenuItem Header="Очистить"/>
                    <Separator/>
                    <MenuItem Header="Свойства" Command="{Binding ShowPropertiesCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>          
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                       <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" Value="#FFBFF4F5"/>
                        </Trigger>                        
                    </Style.Triggers>                    
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">                    
                    <Setter Property="Margin" Value="1.5 3 1.5 3" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="AO">
                            <Setter Property="Background" Value="#FFDFFDDF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="DO">
                            <Setter Property="Background" Value="#FFEDED96" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="None">
                            <Setter Property="Background" Value="#FFFBB8A4" />
                        </DataTrigger><DataTrigger Binding="{Binding Type}" Value="AI">
                            <Setter Property="Background" Value="#FFE8D5F5" />
                        </DataTrigger><DataTrigger Binding="{Binding Type}" Value="DI">
                            <Setter Property="Background" Value="#FFDAD1CE" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFACCEF3"/>
                            <Setter Property="Foreground" Value="Black"/>                            
                        </Trigger>                        
                    </Style.Triggers>
                </Style>                                    
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ п/п" Binding="{Binding NumberReg }" IsReadOnly="True" Width="auto">                    
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Устройство" Binding="{Binding NameDevice}" IsReadOnly="True" Width="auto">
                    <DataGridTextColumn.ElementStyle >
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Команда" Binding="{Binding Prop2}" IsReadOnly="True" Width="auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Тип регистра" Binding="{Binding Type}" IsReadOnly="True" Width="auto" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>                    
                </DataGridTextColumn>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Adress}" IsReadOnly="True" Width="auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Имя регистра" MinWidth="100" Width="*" 
                                    Binding="{Binding Name}" IsReadOnly="False">                   
                    <DataGridTextColumn.ElementStyle>                        
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Формат" Width="auto" IsReadOnly="True" 
                                    Binding="{Binding Format}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Значение" Width="auto" MinWidth="300" IsReadOnly="True" 
                                    Binding="{Binding Value}">                    
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Width" Value="auto"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="0">
                                    <Setter Property="Foreground" Value="red" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>                        
                    </DataGridTextColumn.ElementStyle>                   
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>        
    </Grid>
</UserControl>
