<UserControl Name="Cell"
    x:Class="ModbusMonitor.Controls.UserControlDevices"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:ModbusMonitor.Classes" 
             xmlns:viewmodel="clr-namespace:ModbusMonitor.ViewModel" 
             d:DataContext="{d:DesignInstance Type=viewmodel:ControlDeviceView}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Width" Value="auto"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <DataGrid AutoGenerateColumns="False" SelectionMode="Single" ItemsSource="{Binding Cells}" 
                  SelectionUnit="Cell"
                  HorizontalGridLinesBrush="#FFBDB3B3" FontSize="16" IsReadOnly="True">                  
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderBrush" Value="#FFFBF3F3" />
                    <Setter Property="BorderThickness" Value="0 0 1 1" />
                    <Setter Property="Margin" Value="1" />                    
                </Style>                
            </DataGrid.CellStyle>
            <DataGrid.Columns>                
                <DataGridTextColumn Header="№ п/п" Binding="{Binding NumberReg }">                    
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Устройство" Binding="{Binding NameDevice}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Команда" Binding="{Binding Prop2}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Тип регистра" Binding="{Binding Type}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Adress}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Имя регистра" MinWidth="100" Binding="{Binding Name}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Формат" Width="auto" 
                                    Binding="{Binding Format}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Значение" Width="auto" MinWidth="80" 
                                    Binding="{Binding Value}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>                            
                        </Style>                        
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="График"/>
                                        <MenuItem Header="Лог"/>
                                        <Separator/>
                                        <MenuItem Header="Записать регистр"/>
                                        <MenuItem Header="Вставить ячейки"/>
                                        <MenuItem Header="Формат"/>
                                        <Separator/>
                                        <MenuItem Header="Вырезать"/>
                                        <MenuItem Header="Копировать"/>
                                        <MenuItem Header="Вставить"/>
                                        <MenuItem Header="Удалить"/>
                                        <MenuItem Header="Очистить"/>
                                        <Separator/>
                                        <MenuItem Header="Свойства"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>                           
                        </Style>                        
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
